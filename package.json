{
  "name": "@uqrealitylabs/sauron",
  "version": "0.0.0-development",
  "description": "Tiny rendering budgets, frame pacing, and focused Three.js effects for UQ Reality Labs.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "packageManager": "npm@11.16.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./prism": {
      "types": "./dist/prism.d.ts",
      "import": "./dist/prism.js"
    }
  },
  "scripts": {
    "build": "tsc -p tools/config/tsconfig.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run rank:check && npm run rust:check && npm run build && npm run size",
    "typecheck": "tsc -p tools/config/tsconfig.check.json",
    "lint": "biome check --config-path tools/config/biome.json src tests tools/scripts package.json",
    "format": "biome check --write --config-path tools/config/biome.json src tests tools/scripts package.json",
    "test": "node --test tests/*.test.ts",
    "benchmark": "node tools/scripts/benchmark.ts",
    "branch": "node tools/scripts/branch.ts",
    "rank": "node tools/scripts/rank.ts",
    "rank:check": "node tools/scripts/rank.ts --check",
    "rank:write": "node tools/scripts/rank.ts --write",
    "rust:check": "cargo fmt --check && cargo clippy --all-targets --all-features -- -D warnings && cargo test",
    "size": "node tools/scripts/size.ts",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^24.10.0",
    "@types/three": "^0.177.0",
    "three": "^0.177.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "three": ">=0.177 <0.186"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keys-i/sauron.git"
  },
  "bugs": {
    "url": "https://github.com/keys-i/sauron/issues"
  },
  "homepage": "https://github.com/keys-i/sauron#readme"
}
